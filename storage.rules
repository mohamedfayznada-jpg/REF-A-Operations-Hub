rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function canWrite() {
      return signedIn() && request.auth.token.role != null &&
        request.auth.token.role in ['admin', 'manager', 'engineer', 'supervisor'];
    }

    match /{allPaths=**} {
      allow read: if signedIn();
      allow write: if canWrite() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
