rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : 'viewer';
    }

    function canWrite() {
      return signedIn() && role() in ['admin', 'manager', 'engineer', 'supervisor'];
    }

    match /productionHourly/{id} {
      allow read: if signedIn();
      allow create, update: if canWrite();
      allow delete: if signedIn() && role() == 'admin';
    }

    match /auditLog/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && role() == 'admin';
    }

    match /{document=**} {
      allow read: if signedIn();
      allow create, update: if canWrite();
      allow delete: if signedIn() && role() == 'admin';
    }
  }
}
